+#ifdef LOADER_UMI
+static int
+umi_usb_park(void)
+{
+	if (USB == NULL) return 0;
+	if (usb_rx_queued) {
+		usb_abort_transfer(USB_EP_OUT);
+		usb_rx_queued = 0;
+	}
+	if (EFI_ERROR(USB->stop())) return 0;
+	usb_connected = 0;
+	USB = NULL;
+	print("UMI native USB: firmware released the controller\n");
+	return 1;
+}
+
+static void
+umi_usb_recover(void)
+{
+	wdt_set_ms(45000);
+	if (!usb_start()) {
+		USB = NULL;
+		reboot();
+	}
+}
+#endif
