@@ -87,6 +87,28 @@
 		}
 	}
 	return NULL;
+}
+
+/* The SDX55 BHI transfer happens before process 1.  Kernel and process-1 timer
+ * waits do not resume reliably this early, so process 1 itself is the later
+ * lifecycle boundary: it asks a no-wait worker to observe SBL and perform the
+ * normal safe rollback as soon as the root filesystem is available. */
+static void
+trigger_sdx55_sbl_observation(const char *phase, int final)
+{
+	const char *step = boot_arg("sdx55_step");
+
+	if (step == NULL || strcmp(step, "12") != 0) return;
+	printf("init: SDX55 SBL observation at %s%s\n", phase,
+	    final ? " (final)" : "");
+	int trigger = final ? 2 : 1;
+	if (sysctlbyname("kern.hakios.sdx55_observe", NULL, NULL,
+	    &trigger, sizeof(trigger)) == 0) {
+		printf("init: SDX55 SBL observation worker triggered\n");
+	} else {
+		printf("init: SDX55 SBL observation trigger failed: %s\n",
+		    strerror(errno));
+	}
 }
 
