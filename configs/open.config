# Fragment: the open profile. Nothing of the phone's own is loaded: no GPU, Wi-Fi, audio, haptic, camera or modem firmware.
# Laid over a device's defconfig it gives that phone's configuration without a single file pulled from the device.
CONFIG_FIRMWARE="none"
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_MIC is not set
# CONFIG_WIFI is not set
# CONFIG_HAPTIC is not set
# CONFIG_CAM is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_MODEM_BUFFER is not set
