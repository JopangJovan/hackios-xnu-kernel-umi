# Fragment: keep /private/var across reboots. THIS WRITES TO THE PHONE'S STORAGE, to the partition `darwin` only.
# The kernel and the loader refuse any other write. The partition has to exist: it is cut off the end of Android's
# userdata once, by hand (tools/userdata-carve.py prints the commands and says what they do to Android's data).
# Without that partition, leave this fragment out.
CONFIG_UFS=2
CONFIG_UFS_WRITE=y
CONFIG_VAR_STORE=y
