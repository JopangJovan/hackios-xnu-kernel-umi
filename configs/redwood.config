# HakiOS fragment: the POCO X5 Pro 5G (redwood, devices/redwood) -- what is true of this phone and of no other with the same SoC.
# The vibration motor's variant (5), and where the modem's remote-file-system buffer is in its memory map (a number taken from the
# phone's own device tree; tools/soc-args.py makes it for a phone that has another).
CONFIG_DEVICE="redwood"
CONFIG_HAPTIC=5
CONFIG_MODEM_BUFFER=0xa8000000
